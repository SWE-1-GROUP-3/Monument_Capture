EXPO_PUBLIC_API_URL=http://localhost:8080
# Optional: free CARTO basemaps key for the Voyager map style (https://carto.com/basemaps/apikey/).
# Without it the map uses OpenStreetMap tiles.
EXPO_PUBLIC_CARTO_API_KEY=

# Supabase project settings (publishable key only; never a secret/service-role key).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
