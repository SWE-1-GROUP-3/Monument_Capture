{
  "expo": {
    "name": "Monument Capture",
    "slug": "monument-capture",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "monumentcapture",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Monument Capture to show your location on the monument map."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.monumentcapture.app"
    },
    "android": {
      "package": "com.monumentcapture.app"
    }
  }
}
