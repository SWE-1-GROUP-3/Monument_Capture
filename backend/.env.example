# Copy to backend/.env; source it with `set -a` before running Maven.
# PostgreSQL JDBC URL, using TLS for Supabase connections.
DATABASE_URL=jdbc:postgresql://localhost:55432/monument_capture
DATABASE_USERNAME=monument_app
DATABASE_PASSWORD=
# Use a separate database identity with schema ownership for Flyway.
MIGRATION_DATABASE_URL=jdbc:postgresql://localhost:55432/monument_capture
MIGRATION_DATABASE_USERNAME=monument_migrator
MIGRATION_DATABASE_PASSWORD=
# Supabase project settings. Never put a secret in an EXPO_PUBLIC_ variable.
SUPABASE_URL=http://localhost:54321
SUPABASE_JWT_ISSUER=http://localhost:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
PORT=8080
# Reserved for step 5 private-storage integration; not consumed yet.
PHOTO_BUCKET=monument-photos
SUPABASE_SECRET_KEY=
# Only for the optional local Docker PostgreSQL service. Set a local password.
LOCAL_DB_ADMIN_PASSWORD=
